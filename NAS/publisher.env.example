PUBLISH_REPOSITORY=michaelmvh/reading-site
SITE_URL=https://michaelmvh.com/reading-site/

# First run: validate output without committing or pushing.
PUBLISH_MODE=prepare
# Initial publication only, while the publishing repository has no site/ archive.
BOOTSTRAP_EXPORT=true
ALLOW_FEED_SHRINK=false

GSRF_MAILTO=YOUR_CONTACT_EMAIL
PUBLISH_GIT_NAME=Reading Site Publisher
PUBLISH_GIT_EMAIL=YOUR_GITHUB_NOREPLY_EMAIL

# Credentials belong in secrets.env, mounted read-only as a file by Compose.
# Never put a GitHub token or OpenAlex key in this file or the image.
