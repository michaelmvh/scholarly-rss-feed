# Configure these in the Task Scheduler environment (or a private wrapper script).
# This example is documentation, not a shell file to source automatically.
PUBLISH_CHECKOUT=/volume1/docker/reading-site
WORK_ROOT=/volume1/docker/reading-static-work
SITE_URL=https://michaelmvh.com/reading-site/
STATIC_IMAGE=ghcr.io/michaelmvh/scholarly-rss-feed:REPLACE_WITH_REVIEWED_SHA_TAG
CACHE_VOLUME=reading-static-cache
GSRF_MAILTO=REPLACE_WITH_CONTACT_ADDRESS
DOCKER_BIN=/usr/local/bin/docker
GH_BIN=/usr/local/bin/gh
# First run only, with no site/ directory:
# BOOTSTRAP_EXPORT=1
# One reviewed run only, after intentional feed removal or shrinkage:
# ALLOW_FEED_SHRINK=true
